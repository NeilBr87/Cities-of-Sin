# Copy to .env.local and fill in from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# Both of these are safe in the browser. Row Level Security is what protects the
# data, not the secrecy of the anon key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# NEVER put the service_role key in this file or anywhere under src/.
# It bypasses RLS completely. It belongs only in Supabase Edge Function secrets.
