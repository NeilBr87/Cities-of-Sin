# Leave REACT_APP_XANO_BASE unset to run against the in-browser mock backend.
# Set it to your Xano API group base URL to go live — see docs/XANO_SETUP.md §9.
# REACT_APP_XANO_BASE=https://x8ki-abcd-1234.n7.xano.io/api:aBcD1234

# The setting: seventies (1979, default) | nineties (1994) | modern (2026)
# REACT_APP_ERA=seventies
